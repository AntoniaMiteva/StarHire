@model IEnumerable<StarHire.Models.ViewModels.Jobs.JobViewModel>
@{
    ViewData["Title"] = "Job Listings";
}
@section Styles {
    <link rel="stylesheet" href="~/css/JobsIndex.css" />
}
<div class="jobs-wrapper">
    <div class="page-header">
        <p class="eyebrow">Galactic Opportunities</p>
        <h1><span>Star</span>Hire</h1>
        <div class="header-divider"></div>
    </div>

    <form method="get" asp-action="Index" class="filter-bar">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search positions..." />
        <input type="text" name="planet" value="@ViewBag.Planet" placeholder="Planet / location..." />
        <input type="number" name="minSalary" value="@ViewBag.MinSalary" placeholder="Min salary $" step="100" min="0" />
        <button type="submit" class="btn-filter">Scan ›</button>
    </form>

    @if (User.IsInRole("Employer"))
    {
        <div class="post-job-bar">
            <a asp-action="Create" class="btn-post">+ Post New Job</a>
        </div>
    }

    @if (User.IsInRole("Alien") && ViewBag.RecommendedJobs != null && ((IEnumerable<StarHire.Models.ViewModels.Jobs.JobViewModel>)ViewBag.RecommendedJobs).Any())
    {
        <div class="recommended-section">
            <h3 class="recommended-title">⭐ Recommended for You</h3>
            <div class="jobs-grid">
                @foreach (var job in ((IEnumerable<StarHire.Models.ViewModels.Jobs.JobViewModel>)ViewBag.RecommendedJobs).OrderByDescending(j => j.CompatibilityPercent).Take(3))
                {
                    <a href="@Url.Action("Details", "Jobs", new { id = job.Id })" class="job-card">
                        <div class="corner-accent"></div>
                        <div class="planet-tag">
                            <span class="planet-dot"></span>
                            @job.Planet
                        </div>
                        <h2 class="job-title-card">@job.Title</h2>
                        <p class="job-description">@job.Description</p>
                        <div class="card-bottom">
                            <div class="salary-display">
                                @job.Salary.ToString("N0")<small>₵ / cycle</small>
                            </div>
                        </div>
                        @if (job.CompatibilityPercent.HasValue)
                        {
                            <div class="compatibility-bar">
                                <div class="compatibility-fill" style="width:@job.CompatibilityPercent%"></div>
                                <span class="compatibility-label">@job.CompatibilityPercent% match</span>
                            </div>
                        }
                    </a>
                }
            </div>
        </div>
        <div class="header-divider" style="margin: 2rem 0;"></div>
    }

    <div class="jobs-grid">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <p style="font-size:2rem;margin-bottom:0.5rem;">🛸</p>
                <p>No missions found. Try adjusting your search.</p>
            </div>
        }
        else
        {
            @foreach (var job in Model)
            {
                <div class="job-card-wrapper" style="position:relative;">
                    @if (User.IsInRole("Alien"))
                    {
                        <form method="post" asp-controller="Favorites" asp-action="Toggle" style="position:absolute; top:10px; right:10px; z-index:10;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="jobId" value="@job.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="heart-btn @(ViewBag.FavoriteIds != null && ((List<Guid>)ViewBag.FavoriteIds).Contains(job.Id) ? "favorited" : "")">
                                ♥
                            </button>
                        </form>
                    }
                    <a href="@Url.Action("Details", "Jobs", new { id = job.Id })" class="job-card">
                        <div class="corner-accent"></div>
                        <div class="planet-tag">
                            <span class="planet-dot"></span>
                            @job.Planet
                        </div>
                        <h2 class="job-title-card">@job.Title</h2>
                        <p class="job-description">@job.Description</p>
                        <div class="card-bottom">
                            <div class="salary-display">
                                @job.Salary.ToString("N0")<small>₵ / cycle</small>
                            </div>
                            <div class="applicant-count">
                                <span>@job.Applications.Count</span> applied
                            </div>
                        </div>
                        @if (job.CompatibilityPercent.HasValue)
                        {
                            <div class="compatibility-bar">
                                <div class="compatibility-fill" style="width:@job.CompatibilityPercent%"></div>
                                <span class="compatibility-label">@job.CompatibilityPercent% match</span>
                            </div>
                        }
                    </a>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.job-card').forEach(card => {
            card.addEventListener('mousemove', e => {
                const r = card.getBoundingClientRect();
                card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
                card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
            });
        });
    </script>
}
