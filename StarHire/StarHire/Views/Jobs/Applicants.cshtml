@model List<StarHire.Models.ViewModels.Applications.ApplicantViewModel>
@{
    ViewData["Title"] = "Applicants";
}

@section Styles {
    <link rel="stylesheet" href="~/css/JobsIndex.css" />
    <link rel="stylesheet" href="~/css/Applicants.css" />
}

<div style="position:relative; z-index:1; padding: 3rem 1.5rem 5rem;">

    <div class="page-header">
        <p class="eyebrow">Crew Candidates</p>
        <h1>APPLI<span>CANTS</span></h1>
        <div class="header-divider"></div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div style="font-size:2.5rem; margin-bottom:1rem; opacity:0.3;">👾</div>
            <p style="font-family:'Rajdhani',sans-serif; font-size:1.1rem;">No applicants yet for this position.</p>
        </div>
    }
    else
    {
        <div class="jobs-grid">
            @foreach (var applicant in Model)
            {
                <div class="job-card applicant-card">
                    <div class="corner-accent"></div>

                    <p class="planet-tag">
                        <span class="planet-dot"></span>
                        CANDIDATE
                    </p>

                    <h3 class="job-title-card">@applicant.AlienUserName</h3>
                    <p class="job-description">@applicant.AlienEmail</p>

                    <div class="card-bottom">
                        @{
                            var statusClass = applicant.Status?.ToLower() switch
                            {
                                "approved" => "badge-approved",
                                "rejected" => "badge-rejected",
                                _ => "badge-pending"
                            };
                        }
                        <span class="status-badge @statusClass">@applicant.Status</span>
                    </div>

                    <div style="margin-top:1rem; display:flex; gap:0.5rem;">
                        <form asp-controller="Applications" asp-action="UpdateStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="applicationId" value="@applicant.ApplicationId" />
                            <input type="hidden" name="jobId" value="@ViewBag.JobId" />
                            <input type="hidden" name="status" value="1" />
                            <button type="submit" class="btn-back" style="background:#00c896; border-color:#00c896;">✓ Approve</button>
                        </form>
                        <form asp-controller="Applications" asp-action="UpdateStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="applicationId" value="@applicant.ApplicationId" />
                            <input type="hidden" name="jobId" value="@ViewBag.JobId" />
                            <input type="hidden" name="status" value="2" />
                            <button type="submit" class="btn-back" style="background:#ff4757; border-color:#ff4757;">✗ Reject</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }

    <div style="text-align:center; margin-top:2.5rem;">
        <a asp-action="MyJobs" asp-controller="Jobs" class="btn-back">&larr; Back to My Jobs</a>
    </div>

</div>
