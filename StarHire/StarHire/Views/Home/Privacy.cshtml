@{
    ViewData["Title"] = "Privacy Policy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Privacy.css" />
}

<div class="privacy-wrapper">

    <div class="page-header">
        <p class="eyebrow">StarHire Legal</p>
        <h1>PRIVACY <span>POLICY</span></h1>
        <div class="header-divider"></div>
        <p class="last-updated">Last updated: January 2026</p>
    </div>

    <div class="privacy-card">
        <div class="corner-accent"></div>

        <section class="policy-section">
            <div class="section-number">01</div>
            <div class="section-content">
                <h2>Information We Collect</h2>
                <p>When you register and use StarHire, we collect information you provide directly to us, including your name, email address, password, and any profile or application data you submit. We also automatically collect certain technical data such as your IP address, browser type, and usage patterns to improve our services.</p>
            </div>
        </section>

        <div class="section-divider"></div>

        <section class="policy-section">
            <div class="section-number">02</div>
            <div class="section-content">
                <h2>How We Use Your Information</h2>
                <p>We use the information we collect to operate and improve StarHire, process your job applications, communicate with you about your account and activities, send relevant notifications, and ensure the security and integrity of our platform. We do not sell your personal data to third parties.</p>
            </div>
        </section>

        <div class="section-divider"></div>

        <section class="policy-section">
            <div class="section-number">03</div>
            <div class="section-content">
                <h2>Information Sharing</h2>
                <p>Your profile and application information is shared with employers only when you apply to their listed positions. We may also share data with trusted service providers who assist us in operating our platform, subject to strict confidentiality agreements. We will disclose information when required by law or to protect the rights and safety of our users.</p>
            </div>
        </section>

        <div class="section-divider"></div>

        <section class="policy-section">
            <div class="section-number">04</div>
            <div class="section-content">
                <h2>Data Security</h2>
                <p>We implement industry-standard security measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction. All data is encrypted in transit using TLS, and sensitive credentials are stored using secure hashing algorithms. However, no method of transmission over the internet is 100% secure.</p>
            </div>
        </section>

        <div class="section-divider"></div>

        <section class="policy-section">
            <div class="section-number">05</div>
            <div class="section-content">
                <h2>Cookies</h2>
                <p>StarHire uses cookies and similar tracking technologies to maintain your session, remember your preferences, and analyze platform usage. You can control cookie settings through your browser, though disabling certain cookies may affect platform functionality.</p>
            </div>
        </section>

        <div class="section-divider"></div>

        <section class="policy-section">
            <div class="section-number">06</div>
            <div class="section-content">
                <h2>Your Rights</h2>
                <p>You have the right to access, correct, or delete your personal data at any time through your account settings. You may also request a copy of the data we hold about you or withdraw consent for specific uses. To exercise any of these rights, please contact us at the address below.</p>
            </div>
        </section>

        <div class="section-divider"></div>

        <section class="policy-section">
            <div class="section-number">07</div>
            <div class="section-content">
                <h2>Contact Us</h2>
                <p>If you have any questions, concerns, or requests regarding this Privacy Policy or your personal data, please reach out to our privacy team at <a href="mailto:privacy@starhire.com">privacy@starhire.com</a>. We aim to respond to all inquiries within 5 business days.</p>
            </div>
        </section>

    </div>

</div>

