@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Auth.css" />
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-header">
            <p class="auth-eyebrow">StarHire Portal</p>
            <h1>PASSWORD <span>RESET</span></h1>
            <div class="auth-divider"></div>
        </div>

        <div class="confirm-icon">✓</div>

        <p class="confirm-message">
            Your password has been successfully reset. You can now sign in with your new credentials.
        </p>

        <a asp-page="./Login" class="btn-auth" style="display:block;text-align:center;text-decoration:none;">
            Return to Sign In
        </a>

    </div>
</div>
