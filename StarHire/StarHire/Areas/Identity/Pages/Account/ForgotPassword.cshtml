@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
@section Styles{
    <link rel="stylesheet" href="~/css/Auth.css"/>
}
<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-header">
            <p class="auth-eyebrow">StarHire Portal</p>
            <h1>FORGOT <span>PASSWORD</span></h1>
            <div class="auth-divider"></div>
        </div>

        <p style="font-family:'Rajdhani',sans-serif;color:var(--text-dim);font-size:0.95rem;margin-bottom:1.6rem;text-align:center;">
            Enter your email and we'll send you a reset link.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.Email">Email Address</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="commander@starhire.com" />
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-auth">Send Reset Link</button>
        </form>

        <div class="auth-footer">
            Remembered it? <a asp-page="./Login">Back to sign in &rarr;</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
