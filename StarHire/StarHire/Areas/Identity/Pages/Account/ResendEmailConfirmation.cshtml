@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend Email Confirmation";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Auth.css" />
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-header">
            <p class="auth-eyebrow">StarHire Portal</p>
            <h1>RESEND <span>CONFIRMATION</span></h1>
            <div class="auth-divider"></div>
        </div>

        <p style="font-family:'Rajdhani',sans-serif;color:var(--text-dim);font-size:0.95rem;margin-bottom:1.6rem;text-align:center;">
            Enter your email and we'll resend the confirmation link.
        </p>

        <form method="post">
            <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.Email">Email Address</label>
                <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="commander@starhire.com" />
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-auth">Resend Confirmation</button>
        </form>

        <div class="auth-footer">
            Already confirmed? <a asp-page="./Login">Sign in &rarr;</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
