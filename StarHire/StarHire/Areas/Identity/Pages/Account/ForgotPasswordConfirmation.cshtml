@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check Your Email";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Auth.css" />
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-header">
            <p class="auth-eyebrow">StarHire Portal</p>
            <h1>CHECK <span>EMAIL</span></h1>
            <div class="auth-divider"></div>
        </div>

        <div class="confirm-icon">✉</div>

        <p class="confirm-message">
            A password reset link has been transmitted to your inbox. Follow the instructions to regain access.
        </p>

        <div class="auth-footer">
            <a asp-page="./Login">Back to sign in &rarr;</a>
        </div>

    </div>
</div>