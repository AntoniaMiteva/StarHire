@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Login.css" />
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-header">
            <p class="auth-eyebrow">StarHire Portal</p>
            <h1>CREATE <span>ACCOUNT</span></h1>
            <div class="auth-divider"></div>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.Email">Email Address</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="commander@starhire.com" />
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••••••" />
                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Input.ConfirmPassword">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Input.Role">Role</label>
                <select asp-for="Input.Role" class="form-control" aria-required="true">
                    <option value="">-- Select Role --</option>
                    <option value="Alien">Alien</option>
                    <option value="Employer">Employer</option>
                </select>
                <span asp-validation-for="Input.Role" class="field-validation-error"></span>
            </div>
            <button id="registerSubmit" type="submit" class="btn-auth" style="margin-top:0.5rem;">Launch Account</button>
        </form>

        <div class="auth-footer">
            Already have an account?
            <a asp-page="./Login">Sign in &rarr;</a>
        </div>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="external-divider">
                    <span>or continue with</span>
                </div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn-external" name="provider" value="@provider.Name"
                                title="Log in using your @provider.DisplayName account">
                            @provider.DisplayName
                        </button>
                    }
                </form>
            }
        }

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
