@page
@model StarHire.Areas.Identity.Pages.Account.Manage.SkillsModel
@{
    ViewData["Title"] = "Skills";
    ViewData["ActivePage"] = ManageNavPages.Skills;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Manage.css" />
}

<div class="manage-wrapper">

    <div class="page-header">
        <p class="eyebrow">StarHire · Account</p>
        <h1>MANAGE <span>ACCOUNT</span></h1>
        <div class="header-divider"></div>
    </div>

    <div class="manage-layout">

        <nav class="manage-nav">
            <p class="nav-label">Settings</p>
            <a asp-page="./Index" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Index ? "active" : "")">Profile</a>
            <a asp-page="./Email" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Email ? "active" : "")">Email</a>
            <a asp-page="./ChangePassword" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.ChangePassword ? "active" : "")">Password</a>
            <a asp-page="./Skills" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Skills ? "active" : "")">Skills</a>
        </nav>

        <div class="manage-card">
            <h3>Skills</h3>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="status-success">✓ @TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="status-error">⚠ @TempData["ErrorMessage"]</div>
            }

            <p class="skills-label">My Skills</p>

            @if (!Model.MySkills.Any())
            {
                <p class="skills-empty">No skills yet. Add your first one below.</p>
            }
            else
            {
                <div class="skills-tags">
                    @foreach (var s in Model.MySkills)
                    {
                        <form method="post" asp-page-handler="Remove" style="display:contents;">
                            <input type="hidden" name="skillName" value="@s" />
                            <span class="skill-tag">
                                @s
                                <button type="submit" title="Remove @s">✕</button>
                            </span>
                        </form>
                    }
                </div>
            }

            <div class="manage-divider"></div>

            <p class="skills-label">Add a Skill</p>

            <form method="post" asp-page-handler="Add">
                <div class="add-skill-row">
                    <input class="form-control"
                           name="SkillName"
                           list="allSkills"
                           placeholder="Type or select a skill..." />
                    <datalist id="allSkills">
                        @foreach (var s in Model.AllSkills)
                        {
                            <option value="@s"></option>
                        }
                    </datalist>
                    <button type="submit" class="btn-add-skill">Add</button>
                </div>
                <p class="skills-hint">You can type a brand new skill and it will be created.</p>
            </form>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
