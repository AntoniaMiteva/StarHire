@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Manage.css" />
}

<div class="manage-wrapper">

    <div class="page-header">
        <p class="eyebrow">StarHire · Account</p>
        <h1>MANAGE <span>ACCOUNT</span></h1>
        <div class="header-divider"></div>
    </div>

    <div class="manage-layout">

        <nav class="manage-nav">
            <p class="nav-label">Settings</p>
            <a asp-page="./Index" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Index ? "active" : "")">Profile</a>
            <a asp-page="./Email" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Email ? "active" : "")">Email</a>
            <a asp-page="./ChangePassword" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.ChangePassword ? "active" : "")">Password</a>
            <a asp-page="./Skills" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Skills ? "active" : "")">Skills</a>
        </nav>

        <div class="manage-card">
            <h3>Profile</h3>

            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="Username">Username</label>
                    <input asp-for="Username" class="form-control" placeholder="Your username" disabled />
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.PhoneNumber">Phone Number</label>
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+1 234 567 8900" />
                    <span asp-validation-for="Input.PhoneNumber" class="field-validation-error"></span>
                </div>

                <button id="update-profile-button" type="submit" class="btn-manage">Save Changes</button>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
