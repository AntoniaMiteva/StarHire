@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Manage.css" />
}

<div class="manage-wrapper">

    <div class="page-header">
        <p class="eyebrow">StarHire · Account</p>
        <h1>MANAGE <span>ACCOUNT</span></h1>
        <div class="header-divider"></div>
    </div>

    <div class="manage-layout">

        <nav class="manage-nav">
            <p class="nav-label">Settings</p>
            <a asp-page="./Index" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Index ? "active" : "")">Profile</a>
            <a asp-page="./Email" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Email ? "active" : "")">Email</a>
            <a asp-page="./ChangePassword" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.ChangePassword ? "active" : "")">Password</a>
            <a asp-page="./Skills" class="@(ViewData["ActivePage"]?.ToString() == ManageNavPages.Skills ? "active" : "")">Skills</a>
        </nav>

        <div class="manage-card">
            <h3>Change Password</h3>

            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.OldPassword">Current Password</label>
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••••••" />
                    <span asp-validation-for="Input.OldPassword" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.NewPassword">New Password</label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••••••" />
                    <span asp-validation-for="Input.NewPassword" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.ConfirmPassword">Confirm New Password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn-manage">Update Password</button>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
